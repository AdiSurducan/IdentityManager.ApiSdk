        ],
        "Data": [
          {
            "Name": "FirstName",
            "Value": "John"
          },
          {
            "Name":"LastName",
            "Value":"Wick"
          },
          {
            "Name":"Remarks",
            "Value":"API Development Training"
          }
        ]
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
